{
  "name": "browser-ai",
  "version": "0.1.0",
  "private": false,
  "description": "Local-first Chrome extension that scans web forms, remembers answers, and fills them with optional pluggable LLM, STT, and TTS providers.",
  "license": "MIT",
  "author": "Browser AI Contributors",
  "keywords": [
    "chrome-extension",
    "form-filling",
    "local-first",
    "ollama",
    "whisper",
    "openai",
    "anthropic",
    "tts",
    "stt",
    "browser-automation",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhijeethrkgadwal/web-pa.git"
  },
  "bugs": {
    "url": "https://github.com/abhijeethrkgadwal/web-pa/issues"
  },
  "homepage": "https://github.com/abhijeethrkgadwal/web-pa#readme",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/build-harness.mjs && playwright test",
    "test:e2e:install": "playwright install chromium",
    "dev:extension": "pnpm --filter @browser-ai/extension dev",
    "build:extension": "pnpm --filter @browser-ai/extension build",
    "serve:fixtures": "node scripts/serve-fixtures.mjs",
    "serve:stt": "pnpm --filter @browser-ai/stt start"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "turbo": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
